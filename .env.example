# Supabase (new-format API keys — https://supabase.com/dashboard → Project Settings → API keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Public Storage bucket that holds uploaded song audio
SUPABASE_STORAGE_BUCKET=song-audio

# Postgres connection used only by `npm run db:migrate` (Session pooler string — see README)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Song-metadata inference on upload
OPENAI_API_KEY=sk-...
# Contact for the MusicBrainz User-Agent used by the cover-art agent (recommended)
MUSICBRAINZ_CONTACT=you@example.com

